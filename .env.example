# --- Supabase (required) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- AI providers (server-side keys, shared by all users of the deployment) ---
# Any provider left unset is simply marked "not configured" in the UI.
OPENROUTER_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
# Optional: https://api.airforce works without a key for many models
AIRFORCE_API_KEY=

# Optional: canonical app URL (used for OpenRouter attribution headers)
NEXT_PUBLIC_APP_URL=http://localhost:3000
